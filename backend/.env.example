SHADOWVAULT_APP_NAME="ShadowVault AI"
SHADOWVAULT_ENVIRONMENT=development
# Omit DATABASE_URL to use backend/shadowvault.db regardless of working directory.
# Relative SQLite paths, if supplied, are relative to the process working directory.
# SHADOWVAULT_DATABASE_URL=sqlite:///./shadowvault.db
SHADOWVAULT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Phase 2A operator identity. Obtain these two values from `python -m app.cli init-operator`.
# Keep the raw operator token in a password manager; put only its digest here.
# SHADOWVAULT_OPERATOR_USER_ID=<investigator UUID>
# SHADOWVAULT_OPERATOR_TOKEN_SHA256=<64 lowercase hex characters>
SHADOWVAULT_AGENT_TOKEN_HOURS=24
SHADOWVAULT_MAX_UPLOAD_BYTES=104857600
SHADOWVAULT_MAX_JOB_BYTES=524288000
SHADOWVAULT_UPLOAD_TIMEOUT_SECONDS=120
SHADOWVAULT_MAX_CONCURRENT_UPLOADS=4
# Default private evidence directory: backend/var/evidence.
# SHADOWVAULT_EVIDENCE_DIR=<absolute private directory>

# Phase 3B verified-copy retrieval; no schema migration beyond 0004.
# SHADOWVAULT_RETRIEVAL_DIR=<absolute private temporary directory>
SHADOWVAULT_MAX_RETRIEVAL_BYTES=104857600
SHADOWVAULT_RETRIEVAL_TIMEOUT_SECONDS=120
SHADOWVAULT_MAX_CONCURRENT_RETRIEVALS=2

# Phase 7I: disabled by default. Do not enable for real cases during evaluation.
SHADOWVAULT_AI_ENABLED=false
# SHADOWVAULT_AI_ADAPTER_SCRIPT=<absolute reviewed .py adapter path>
# SHADOWVAULT_AI_PROVIDER_API_KEY=<backend-only value from secure environment>
SHADOWVAULT_AI_MIN_INTERVAL_SECONDS=5
SHADOWVAULT_AI_MAX_PER_MINUTE=6
SHADOWVAULT_AI_MAX_ATTEMPTS=96

# Phase 7J test evaluator ONLY; these do not enable a production provider.
# Keep the actual key in backend/.env or the backend process environment, never frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Phase 7J-G synthetic evaluator ONLY; does not enable a production Gemini provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
